// База данных: MySQL / MariaDB (хостинг Beget).
// DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  login     String   @unique
  password  String
  name      String
  role      String   @default("admin") // admin | seller
  createdAt DateTime @default(now())
}

model Warehouse {
  id        Int             @id @default(autoincrement())
  name      String
  address   String? @db.Text
  note      String? @db.Text
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  stocks    Stock[]
  movements StockMovement[]
  sales     Sale[]
  receipts  Receipt[]
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  sizeChartId Int? // таблица размеров по умолчанию для товаров категории
  sizeChart   SizeChart? @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  products    Product[]
}

// Объединённая карточка: модель, в которой каждая расцветка — отдельная карточка товара
model ProductGroup {
  id        Int       @id @default(autoincrement())
  wbImtId   Int?      @unique // модель на Wildberries
  createdAt DateTime  @default(now())
  products  Product[]
}

// Таблица размеров: data = JSON { head: ['Размер','Грудь','Талия'], rows: [['S','84','66'], ...], note }
model SizeChart {
  id         Int        @id @default(autoincrement())
  name       String
  data       String     @db.Text
  categories Category[]
  products   Product[]
}

model Product {
  id          Int                @id @default(autoincrement())
  name        String
  sku         String?            @unique // артикул
  description String? @db.Text
  unit        String             @default("шт")
  price       Float              @default(0) // цена продажи
  oldPrice    Float? // старая цена (для ценника)
  costPrice   Float              @default(0) // закупочная цена
  minStock    Float              @default(0) // порог низкого остатка
  weight      Float? // вес, г — для расчёта доставки
  categoryId  Int?
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  active      Boolean            @default(true)
  showInShop  Boolean            @default(true) // показывать в интернет-магазине
  // Варианты «как на WB»: карточка (артикул, фото, описание) + дочерние товары по цвету и размеру,
  // у каждого свой штрихкод и остаток. Продаются и хранятся на складе только варианты.
  parentId    Int?
  parent      Product?           @relation("Variants", fields: [parentId], references: [id], onDelete: Cascade)
  variants    Product[]          @relation("Variants")
  hasVariants Boolean            @default(false)
  // Объединённая карточка «как на WB»: карточки разных цветов одной модели (у каждой свой артикул и фото)
  groupId     Int?
  group       ProductGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  color       String?
  size        String? // размер продавца (S, 44, oversize)
  sizeRu      String? // российский размер (42-48) — как «Рос. размер» на WB
  // Wildberries: артикул WB (nmID) карточки и id модели (imtID)
  wbNmId      Int?               @unique
  wbImtId     Int?
  packLength  Float? // габариты упаковки, см
  packWidth   Float?
  packHeight  Float?
  sort        Int                @default(0) // порядок варианта
  brand       String?
  slug        String? // короткий адрес в магазине: /product/12-plate-leto
  modelInfo   String? // параметры модели на фото: «Рост 175, размер S»
  sizeChartId Int?
  sizeChart   SizeChart?         @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  batches     Batch[]
  favorites   Favorite[]
  waitlist    StockSubscription[]
  reviews     Review[]
  looks       ProductLink[]      @relation("LookOwner")
  inLooks     ProductLink[]      @relation("LookItem")
  barcodes    Barcode[]
  images      ProductImage[]
  attributes  ProductAttribute[]
  stocks      Stock[]
  movements   StockMovement[]
  saleItems   SaleItem[]
  receiptItems ReceiptItem[]
  orderItems  OrderItem[]

  @@index([parentId])
  @@index([groupId])
}

model Barcode {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  type      String  @default("EAN13") // EAN13 | CODE128
  isPrimary Boolean @default(false)
  generated Boolean @default(false)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  path      String
  kind      String  @default("image") // image | video
  color     String? // фото конкретного цвета (для карточки с вариантами)
  sort      Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductAttribute {
  id        Int     @id @default(autoincrement())
  name      String
  value     String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Stock {
  id          Int       @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Float     @default(0)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

// type: RECEIPT (приход) | SALE (продажа) | RETURN (возврат) | ADJUST (корректировка) | TRANSFER_IN | TRANSFER_OUT
model StockMovement {
  id          Int       @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Float // + приход, - расход
  type        String
  note        String? @db.Text
  saleId      Int?
  receiptId   Int?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model SalesChannel {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("retail") // retail | online | marketplace | wholesale | other
  color     String   @default("#2a78d6")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  sales     Sale[]
  expenses  ChannelExpense[]
}

// Расходы на канал продаж (реклама, комиссии) — для сквозной аналитики
model ChannelExpense {
  id        Int          @id @default(autoincrement())
  channelId Int
  date      DateTime // месяц/дата расхода
  amount    Float
  note      String?      @db.Text
  createdAt DateTime     @default(now())
  channel   SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model Counterparty {
  id        Int       @id @default(autoincrement())
  name      String
  type      String    @default("customer") // customer | supplier | both
  phone     String?
  email     String?
  inn       String?
  address   String? @db.Text
  note      String? @db.Text
  createdAt DateTime  @default(now())
  sales     Sale[]
  receipts  Receipt[]
}

model Sale {
  id             Int           @id @default(autoincrement())
  number         String        @unique
  date           DateTime      @default(now())
  status         String        @default("completed") // completed | returned
  channelId      Int?
  counterpartyId Int?
  warehouseId    Int
  discount       Float         @default(0)
  total          Float         @default(0)
  paymentMethod  String        @default("cash") // cash | card | transfer | consignment
  consignment    Boolean       @default(false) // под реализацию (в долг)
  paidAmount     Float         @default(0) // оплачено по реализации
  dueDate        DateTime? // срок оплаты
  note           String? @db.Text
  channel        SalesChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id])
  items          SaleItem[]
  payments       SalePayment[]
}

model SalePayment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  amount    Float
  method    String   @default("cash")
  note      String?  @db.Text
  date      DateTime @default(now())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Float
  returned  Float   @default(0) // возвращено (для реализации)
  price     Float
  costPrice Float   @default(0)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Receipt {
  id             Int           @id @default(autoincrement())
  number         String        @unique
  date           DateTime      @default(now())
  warehouseId    Int
  counterpartyId Int?
  total          Float         @default(0)
  note           String? @db.Text
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id])
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  items          ReceiptItem[]
}

model ReceiptItem {
  id        Int     @id @default(autoincrement())
  receiptId Int
  productId Int
  quantity  Float
  costPrice Float   @default(0)
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Setting {
  key   String @id
  value String @db.Text
}

// ---------- Интернет-магазин ----------

model Customer {
  id        Int      @id @default(autoincrement())
  phone     String   @unique // 7XXXXXXXXXX
  name      String?
  email     String?
  address   String?  @db.Text
  createdAt DateTime @default(now())
  lastLogin DateTime?
  consentAt DateTime? // согласие на обработку персональных данных
  cart          String?   @db.Text // корзина (для напоминания о брошенной корзине)
  cartUpdatedAt DateTime?
  cartReminded  Int       @default(0) // 0 — не напоминали, 1 — через 2 ч, 2 — через сутки
  orders    Order[]
  chats     Conversation[]
  favorites Favorite[]
  waitlist  StockSubscription[]
  reviews   Review[]
}

model SmsCode {
  id        Int      @id @default(autoincrement())
  phone     String
  codeHash  String
  ip        String?
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// status: new | confirmed | ready | completed | cancelled
// paymentStatus: unpaid | pending | paid | failed | refunded
model Order {
  id            Int         @id @default(autoincrement())
  number        String      @unique
  customerId    Int
  status        String      @default("new")
  paymentMethod String      @default("cash") // cash | tbank
  paymentStatus String      @default("unpaid")
  paymentId     String? // PaymentId в Т-Банке
  paymentUrl    String?     @db.Text
  delivery      String      @default("pickup") // id способа доставки
  deliveryName  String? // название способа на момент заказа
  deliveryInfo  String?     @db.Text // JSON: город, пункт выдачи, индекс, срок
  address       String?     @db.Text
  name          String?
  phone         String
  comment       String?     @db.Text
  subtotal      Float       @default(0)
  deliveryPrice Float       @default(0)
  total         Float       @default(0)
  saleId        Int? // продажа, созданная при выдаче заказа
  adminNote     String?     @db.Text
  agreedAt      DateTime? // принял оферту и условия возврата
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customer      Customer    @relation(fields: [customerId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  name      String
  price     Float
  quantity  Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

// ---------- Чат с покупателями ----------

model Conversation {
  id             Int           @id @default(autoincrement())
  visitorKey     String        @unique // идентификатор посетителя (в браузере)
  customerId     Int?
  name           String?
  phone          String?
  status         String        @default("open") // open | closed
  unreadAdmin    Int           @default(0)
  unreadCustomer Int           @default(0)
  lastMessageAt  DateTime      @default(now())
  lastText       String?       @db.Text
  createdAt      DateTime      @default(now())
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages       ChatMessage[]

  @@index([lastMessageAt])
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  sender         String // customer | admin
  userId         Int? // сотрудник, ответивший из админки
  text           String?      @db.Text
  image          String? // /uploads/chat/...
  audio          String? // голосовое сообщение /uploads/chat/...
  duration       Int? // длительность голосового, сек
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
}

// Подписки на пуш-уведомления браузера (Web Push)
model PushSubscription {
  id         Int      @id @default(autoincrement())
  endpoint   String   @db.VarChar(700)
  keys       String   @db.Text // JSON { p256dh, auth }
  userId     Int? // сотрудник (админка)
  visitorKey String? // покупатель (чат)
  createdAt  DateTime @default(now())

  @@unique([endpoint(length: 500)])
}

// ---------- Партии: у каждого поступления своя себестоимость ----------
// Остаток партии уменьшается при продаже (FIFO — сначала старые партии); себестоимость продажи
// считается по фактическим партиям. Поставщик и дата — для истории закупок одного артикула.
model Batch {
  id          Int        @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Float // пришло
  remaining   Float // осталось
  costPrice   Float      @default(0)
  date        DateTime   @default(now())
  supplierId  Int? // контрагент-поставщик
  receiptId   Int?
  note        String?    @db.Text
  createdAt   DateTime   @default(now())
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  uses        BatchUse[]

  @@index([productId, warehouseId, remaining])
}

// Сколько и из какой партии списано (продажа, перемещение) — чтобы при возврате вернуть в ту же партию
model BatchUse {
  id         Int      @id @default(autoincrement())
  batchId    Int
  saleItemId Int?
  quantity   Float
  returned   Float    @default(0)
  costPrice  Float
  createdAt  DateTime @default(now())
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([saleItemId])
}

// ---------- Витрина: избранное, ожидание поступления, отзывы, образы ----------
model Favorite {
  id         Int      @id @default(autoincrement())
  customerId Int
  productId  Int
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

// «Сообщить о поступлении» нужного варианта
model StockSubscription {
  id         Int       @id @default(autoincrement())
  customerId Int
  productId  Int
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

// status: pending | published | rejected; fit: small | ok | large
model Review {
  id         Int      @id @default(autoincrement())
  productId  Int // карточка товара
  customerId Int
  rating     Int
  fit        String?
  size       String? // какой размер брал
  text       String?  @db.Text
  photos     String?  @db.Text // JSON ["/uploads/reviews/..."]
  purchased  Boolean  @default(false) // покупал этот товар
  status     String   @default("pending")
  reply      String?  @db.Text
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([productId, status])
}

// «Собрать образ»: товары, которые показываются вместе с этим
model ProductLink {
  id        Int     @id @default(autoincrement())
  productId Int
  linkedId  Int
  sort      Int     @default(0)
  product   Product @relation("LookOwner", fields: [productId], references: [id], onDelete: Cascade)
  linked    Product @relation("LookItem", fields: [linkedId], references: [id], onDelete: Cascade)

  @@unique([productId, linkedId])
}
