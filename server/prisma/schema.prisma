// База данных: MySQL / MariaDB (хостинг Beget).
// DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  login     String   @unique
  password  String
  name      String
  role      String   @default("admin") // admin | seller
  createdAt DateTime @default(now())
}

model Warehouse {
  id        Int             @id @default(autoincrement())
  name      String
  address   String? @db.Text
  note      String? @db.Text
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  stocks    Stock[]
  movements StockMovement[]
  sales     Sale[]
  receipts  Receipt[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int                @id @default(autoincrement())
  name        String
  sku         String?            @unique // артикул
  description String? @db.Text
  unit        String             @default("шт")
  price       Float              @default(0) // цена продажи
  oldPrice    Float? // старая цена (для ценника)
  costPrice   Float              @default(0) // закупочная цена
  minStock    Float              @default(0) // порог низкого остатка
  categoryId  Int?
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  barcodes    Barcode[]
  images      ProductImage[]
  attributes  ProductAttribute[]
  stocks      Stock[]
  movements   StockMovement[]
  saleItems   SaleItem[]
  receiptItems ReceiptItem[]
}

model Barcode {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  type      String  @default("EAN13") // EAN13 | CODE128
  isPrimary Boolean @default(false)
  generated Boolean @default(false)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  path      String
  sort      Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductAttribute {
  id        Int     @id @default(autoincrement())
  name      String
  value     String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Stock {
  id          Int       @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Float     @default(0)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

// type: RECEIPT (приход) | SALE (продажа) | RETURN (возврат) | ADJUST (корректировка) | TRANSFER_IN | TRANSFER_OUT
model StockMovement {
  id          Int       @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Float // + приход, - расход
  type        String
  note        String? @db.Text
  saleId      Int?
  receiptId   Int?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model SalesChannel {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("retail") // retail | online | marketplace | wholesale | other
  color     String   @default("#2a78d6")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Counterparty {
  id        Int       @id @default(autoincrement())
  name      String
  type      String    @default("customer") // customer | supplier | both
  phone     String?
  email     String?
  inn       String?
  address   String? @db.Text
  note      String? @db.Text
  createdAt DateTime  @default(now())
  sales     Sale[]
  receipts  Receipt[]
}

model Sale {
  id             Int           @id @default(autoincrement())
  number         String        @unique
  date           DateTime      @default(now())
  status         String        @default("completed") // completed | returned
  channelId      Int?
  counterpartyId Int?
  warehouseId    Int
  discount       Float         @default(0)
  total          Float         @default(0)
  paymentMethod  String        @default("cash") // cash | card | transfer
  note           String? @db.Text
  channel        SalesChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id])
  items          SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Float
  price     Float
  costPrice Float   @default(0)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Receipt {
  id             Int           @id @default(autoincrement())
  number         String        @unique
  date           DateTime      @default(now())
  warehouseId    Int
  counterpartyId Int?
  total          Float         @default(0)
  note           String? @db.Text
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id])
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  items          ReceiptItem[]
}

model ReceiptItem {
  id        Int     @id @default(autoincrement())
  receiptId Int
  productId Int
  quantity  Float
  costPrice Float   @default(0)
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Setting {
  key   String @id
  value String
}
